# Builds the C++ version from the local source tree containing this file.
pkgname=clipboard-sync-cpp
pkgver=0.1.0
pkgrel=1
pkgdesc='Low-latency bidirectional clipboard synchronization between X11 and Wayland (C++17)'
arch=('x86_64' 'aarch64')
license=('MIT' 'BSD-2-Clause')
depends=('gcc-libs' 'xclip' 'wl-clipboard' 'clipnotify')
makedepends=('cmake' 'gcc' 'make')
provides=('clipboard-sync')
conflicts=('clipboard-sync' 'clipboard-sync-git' 'linuxqq-clipsync' 'linuxqq-clipsync-git' 'clipsync' 'clipsync-git')

build() {
  cmake -S "$startdir/../.." -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF
  cmake --build "$srcdir/build" --parallel
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
