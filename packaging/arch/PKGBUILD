_pkgname=clipboard-sync
pkgname=clipboard-sync-git
pkgver=r37.7cd4ee8
pkgrel=1
pkgdesc="Low-latency bidirectional clipboard synchronization between X11 and Wayland"
arch=('x86_64')
url="https://github.com/LengineerC/clipboard-sync"
license=('MIT')
depends=('xclip' 'wl-clipboard' 'clipnotify')
makedepends=('git' 'cargo')

provides=('clipboard-sync')
conflicts=('clipboard-sync' 'linuxqq-clipsync' 'linuxqq-clipsync-git' 'clipsync' 'clipsync-git')
replaces=('linuxqq-clipsync-git' 'clipsync-git')
source=("$_pkgname::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

package() {
  cd "$_pkgname"
  install -Dm755 "target/release/clipboard-sync" "${pkgdir}/usr/bin/clipboard-sync"
  install -Dm644 clipboard-sync.service "${pkgdir}/usr/lib/systemd/user/clipboard-sync.service"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
}
